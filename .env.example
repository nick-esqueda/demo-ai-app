# Copy to .env and fill in. Every setting has a default in src/docs_qa/config.py.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs_qa

# --- Chat model -------------------------------------------------------------
# Default: Google Gemini free tier through its OpenAI-compatible endpoint.
# Get a free key at https://aistudio.google.com/apikey
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=

# Groq free tier instead (key at https://console.groq.com/keys, models at https://console.groq.com/docs/models):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Local model with Ollama (no key needed; run `ollama pull llama3.2` first):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Claude (paid) instead:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# --- Embeddings ---------------------------------------------------------------
# Runs locally; the model downloads from Hugging Face on first use (~130 MB).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval ----------------------------------------------------------------
TOP_K=5
CHUNK_MAX_TOKENS=500
